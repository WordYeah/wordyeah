# Install as /etc/wordyeah/wordyeah.env with mode 0600. Secret values must be
# injected by the host secret store; do not commit them here.
WORDYEAH_BIND=127.0.0.1
WORDYEAH_PORT=18765
WORDYEAH_DATABASE=/var/lib/wordyeah/wordyeah.sqlite3
WORDYEAH_MEDIA_ROOT=/var/lib/wordyeah/media
WORDYEAH_POLICY_PATH=/opt/wordyeah/config/policy.avatar.example.json
WORDYEAH_POLICY_PROFILE=avatar-default
WORDYEAH_CONSUMER_ID=default
# Declarative workspaces are created or reconciled at API startup. Incoming
# adapters select one with X-WordYeah-Workspace; they cannot create arbitrary
# workspace IDs through a request.
WORDYEAH_WORKSPACES_JSON={"cravatar":{"name":"Cravatar","adapter":"cravatar","policy_profile":"avatar-default","enabled":true}}
WORDYEAH_DEVICE=auto
WORDYEAH_MEDIA_MODEL_PATH=/var/lib/wordyeah/models/Falconsai-nsfw_image_detection
WORDYEAH_MAX_QUEUE_DEPTH=1000

# Required before exposing the API beyond loopback.
# WORDYEAH_API_KEY=inject-with-the-host-secret-store

# Reviewer sessions remain unavailable until private credentials are injected.
# WORDYEAH_REVIEW_SESSION_SECRET=inject-with-the-host-secret-store
# WORDYEAH_REVIEWERS_JSON={"reviewer-a":"...","reviewer-b":"...","arbitrator":"..."}

# Advanced vision is fail-closed and disabled by default. Avatar review uses the
# G2A Web pool first, then local Ollama when the Web request cannot conclude.
WORDYEAH_G2A_ENABLED=false
WORDYEAH_G2A_ENDPOINT=http://127.0.0.1:18000/v1/chat/completions
WORDYEAH_G2A_MODEL=grok-chat-fast
# WORDYEAH_G2A_API_KEY=inject-with-the-host-secret-store
# Local fallback. qwen3-vl handles primary-provider failures; gemma3 is the
# independent second review model for low-confidence or conflicting results.
WORDYEAH_OLLAMA_ENABLED=false
WORDYEAH_OLLAMA_ENDPOINT=http://127.0.0.1:11434/v1/chat/completions
WORDYEAH_OLLAMA_MODEL=qwen3-vl:8b
WORDYEAH_OLLAMA_SECONDARY_ENABLED=false
WORDYEAH_OLLAMA_SECONDARY_MODEL=gemma3:12b
# Optional remote independent secondary provider. When enabled it takes
# precedence over WORDYEAH_OLLAMA_SECONDARY_*.
WORDYEAH_G2A_SECONDARY_ENABLED=false
# WORDYEAH_G2A_SECONDARY_ENDPOINT=https://independent-provider.example/v1/chat/completions
# WORDYEAH_G2A_SECONDARY_MODEL=independent-vision-model
# WORDYEAH_G2A_SECONDARY_API_KEY=inject-with-the-host-secret-store
