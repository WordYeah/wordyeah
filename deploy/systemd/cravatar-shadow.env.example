# Non-secret example. Install as /etc/wordyeah/cravatar-shadow.env with mode 0600.
CRAVATAR_WORKSPACE=cravatar
CRAVATAR_MANIFEST=/var/lib/wordyeah/inbox/cravatar-manifest.jsonl
CRAVATAR_ROOT=/var/lib/wordyeah/inbox/images
CRAVATAR_POLL_SECONDS=30
CRAVATAR_BATCH_LIMIT=100
WORDYEAH_ENDPOINT=http://127.0.0.1:18765

# Optional API authentication is read by wordyeah-cravatar without appearing in ExecStart.
# WORDYEAH_API_KEY=inject-with-the-host-secret-store
