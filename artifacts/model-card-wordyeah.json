    "status": "development_smoke_only",
    "real_avatar_corpus": false,
    "production_approval": false
  },
  "limitations": [
    "Vendor-reported training data and metrics are not independent WordYeah acceptance evidence.",
    "Current smoke samples are generated safe fixtures plus a small public positive subset.",
    "Real Cravatar-like samples and manual review are required before review or enforce thresholds are approved."
  ]
